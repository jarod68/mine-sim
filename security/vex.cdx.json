    {
      "id": "GHSA-v422-hmwv-36x6",
      "source": {
        "name": "GITHUB",
        "url": "https://github.com/advisories"
      },
      "analysis": {
        "state": "not_affected",
        "justification": "code_not_reachable",
        "response": [
          "will_not_fix"
        ],
        "detail": "body-parser is configured only with static, valid limit literals ('1kb', '4kb') on authenticated /admin routes. bytes.parse() therefore never returns null/NaN, so the vulnerable branch that silently skips the body-size check is never reached."
      },
      "affects": [
        {
          "ref": "cb7f9151-d268-47e6-a880-f944f93372ad"
        }
      ]
    },
